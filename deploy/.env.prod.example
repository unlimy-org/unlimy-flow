# Telegram
BOT_TOKEN=
OWNER_ID=
CHANNEL_ID=@your_channel

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_CRITIC=gpt-4o-mini
TEMPERATURE_GENERATOR=0.7
TEMPERATURE_CRITIC=0.3
MAX_TOKENS_GENERATOR=1500
MAX_TOKENS_CRITIC=1500
MAX_RETRIES=3

# Bot behavior
PUBLISH_MODE=queue
CUSTOM_STAR_EMOJI_ID=
LOG_DIR=logs

# App DB/Redis URLs (internal docker network)
PG_DSN=postgresql://postgres:postgres@postgres:5432/unlimyflow
REDIS_URL=redis://redis:6379/0

# PostgreSQL container vars
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unlimyflow

